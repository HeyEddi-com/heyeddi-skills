{
  "skill": "heyeddi-pr-review",
  "version": "2.0.0",
  "tools": [
    {
      "name": "fetch_pr_context",
      "description": "Fetch PR metadata, committed diff stats, and changed file list (gh or fixture).",
      "parameters": {
        "type": "object",
        "properties": {
          "pr": { "type": "integer", "description": "Pull request number" },
          "project_root": { "type": "string", "description": "Workspace root path" },
          "fixture": { "type": "string", "description": "Optional fixture JSON path (eval/CI without gh)" }
        },
        "required": ["pr", "project_root"]
      },
      "script": "scripts/fetch_pr_context.py",
      "readonly": true
    },
    {
      "name": "post_inline_review",
      "description": "Submit a GitHub PR review with inline comments on exact lines (APPROVE if empty findings).",
      "parameters": {
        "type": "object",
        "properties": {
          "pr": { "type": "integer" },
          "project_root": { "type": "string" },
          "findings_file": { "type": "string" },
          "findings_json": { "type": "string" },
          "event": { "type": "string" },
          "body": { "type": "string" },
          "dry_run": { "type": "boolean" },
          "fixture_out": { "type": "string" }
        },
        "required": ["pr", "project_root"]
      },
      "script": "scripts/post_inline_review.py",
      "readonly": false
    },
    {
      "name": "verify_inline_review",
      "description": "Verify drafted findings were posted as inline line comments (or APPROVE when empty).",
      "parameters": {
        "type": "object",
        "properties": {
          "pr": { "type": "integer" },
          "project_root": { "type": "string" },
          "findings_file": { "type": "string" },
          "posted_file": { "type": "string" },
          "check": { "type": "boolean" }
        },
        "required": ["pr", "project_root"]
      },
      "script": "scripts/verify_inline_review.py",
      "readonly": true
    },
    {
      "name": "audit_pr_changes",
      "description": "Optional engineering signals on changed files (helper; not a substitute for inline review).",
      "parameters": {
        "type": "object",
        "properties": {
          "pr": { "type": "integer" },
          "project_root": { "type": "string" },
          "context": { "type": "string" },
          "fixture": { "type": "string" }
        },
        "required": ["pr", "project_root"]
      },
      "script": "scripts/audit_pr_changes.py",
      "readonly": true
    }
  ]
}
