{
  "skill": "dart-type-bridger",
  "version": "1.0.1",
  "tools": [
    {
      "name": "sync_openapi",
      "description": "Sync local openapi.json to Dart model stubs under lib/models/ (no network fetch).",
      "parameters": {
        "type": "object",
        "properties": {
          "project_root": { "type": "string" },
          "openapi": {
            "type": "string",
            "description": "OpenAPI file relative to project root (default: openapi.json)"
          }
        },
        "required": ["project_root"]
      },
      "script": "scripts/sync_openapi.py",
      "readonly": false
    },
    {
      "name": "fetch_firestore_schema",
      "description": "Read Firestore rules / schema hints.",
      "parameters": {
        "type": "object",
        "properties": { "project_root": { "type": "string" } },
        "required": ["project_root"]
      },
      "script": "scripts/fetch_firestore_schema.py",
      "readonly": true
    }
  ]
}
