{
  "skill": "heyeddi-ci-fails",
  "version": "1.1.0",
  "tools": [
    {
      "name": "fetch_failing_checks",
      "description": "Fetch failing PR Checks / rollup via gh (or fixture).",
      "parameters": {
        "type": "object",
        "properties": {
          "pr": { "type": "integer" },
          "project_root": { "type": "string" },
          "fixture": { "type": "string" }
        },
        "required": ["pr", "project_root"]
      },
      "script": "scripts/fetch_failing_checks.py",
      "readonly": true
    },
    {
      "name": "write_ci_fails_report",
      "description": "Write ephemeral .heyeddi/docs/pr-<N>-ci-fails.md from raw evidence.",
      "parameters": {
        "type": "object",
        "properties": {
          "pr": { "type": "integer" },
          "project_root": { "type": "string" },
          "input": { "type": "string" },
          "force": { "type": "boolean" }
        },
        "required": ["pr", "project_root"]
      },
      "script": "scripts/write_ci_fails_report.py",
      "readonly": false
    },
    {
      "name": "discover_and_verify",
      "description": "Discover evidenced npm/pytest/go/cargo/make commands; optionally run.",
      "parameters": {
        "type": "object",
        "properties": {
          "project_root": { "type": "string" },
          "run": { "type": "boolean" },
          "kinds": { "type": "string" }
        },
        "required": ["project_root"]
      },
      "script": "scripts/discover_and_verify.py",
      "readonly": false
    },
    {
      "name": "assert_no_merge",
      "description": "Hard-fail merge-like plans unless authorize merge this turn.",
      "parameters": {
        "type": "object",
        "properties": {
          "user_text": { "type": "string" },
          "planned_command": { "type": "string" },
          "check": { "type": "boolean" }
        },
        "required": []
      },
      "script": "scripts/assert_no_merge.py",
      "readonly": true
    }
  ]
}
