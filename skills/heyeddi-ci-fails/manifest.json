{
  "skill": "heyeddi-ci-fails",
  "version": "1.1.1",
  "tools": [
    {
      "name": "fetch_failing_checks",
      "description": "Fetch failing and pending PR Checks via gh (or fixture) into the system temp directory.",
      "parameters": {
        "type": "object",
        "properties": {
          "pr": { "type": "integer" },
          "project_root": { "type": "string" },
          "fixture": { "type": "string" }
        },
        "required": ["pr", "project_root"]
      },
      "script": "scripts/fetch_failing_checks.py",
      "readonly": true
    },
    {
      "name": "write_ci_fails_report",
      "description": "Write ephemeral pr-<N>-ci-fails.md in the system temp directory from raw evidence.",
      "parameters": {
        "type": "object",
        "properties": {
          "pr": { "type": "integer" },
          "project_root": { "type": "string" },
          "input": { "type": "string" },
          "force": { "type": "boolean" }
        },
        "required": ["pr", "project_root"]
      },
      "script": "scripts/write_ci_fails_report.py",
      "readonly": false
    },
    {
      "name": "discover_and_verify",
      "description": "Discover evidenced npm/pytest/go/cargo/make commands; optionally run.",
      "parameters": {
        "type": "object",
        "properties": {
          "project_root": { "type": "string" },
          "run": { "type": "boolean" },
          "kinds": { "type": "string" }
        },
        "required": ["project_root"]
      },
      "script": "scripts/discover_and_verify.py",
      "readonly": false
    },
    {
      "name": "assert_no_merge",
      "description": "Run before a merge: fails when the planned command merges into production without the user's authorize merge. Below production it passes (run the pre-merge gate first). Pass base and planned_command.",
      "parameters": {
        "type": "object",
        "properties": {
          "base": { "type": "string", "description": "PR target branch; missing means production" },
          "planned_command": { "type": "string" },
          "user_text": { "type": "string" },
          "check": { "type": "boolean" },
          "project_root": { "type": "string" },
          "check_yaml": { "type": "boolean" }
        },
        "required": []
      },
      "script": "scripts/assert_no_merge.py",
      "readonly": true
    }
  ]
}
