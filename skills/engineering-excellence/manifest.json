{
  "skill": "engineering-excellence",
  "version": "1.5.0",
  "tools": [
    {
      "name": "init_engineering_docs",
      "description": "Scaffold .heyeddi/docs/engineering/ (architecture, reuse catalog, decisions).",
      "parameters": {
        "type": "object",
        "properties": {
          "project_root": { "type": "string", "description": "Workspace root path" },
          "force": { "type": "boolean", "description": "Overwrite stub templates" }
        },
        "required": ["project_root"]
      },
      "script": "scripts/init_engineering_docs.py",
      "readonly": false
    },
    {
      "name": "check_engineering_plan",
      "description": "Always-on plan gate: engineering docs ready + optional plan YAGNI/KISS, budget, and polling-without-event-path smells.",
      "parameters": {
        "type": "object",
        "properties": {
          "project_root": { "type": "string" },
          "plan_file": { "type": "string", "description": "Optional plan markdown path" },
          "plan_text": { "type": "string", "description": "Optional plan text" },
          "check": { "type": "boolean", "description": "Exit non-zero on errors" }
        },
        "required": ["project_root"]
      },
      "script": "scripts/check_engineering_plan.py",
      "readonly": true
    },
    {
      "name": "audit_engineering",
      "description": "Always-on change gate: KISS/YAGNI/SOLID/testability scan; write engineering-audit report.",
      "parameters": {
        "type": "object",
        "properties": {
          "project_root": { "type": "string" },
          "check": { "type": "boolean", "description": "Exit non-zero on errors" },
          "strict": { "type": "boolean", "description": "Exit non-zero on warnings too" }
        },
        "required": ["project_root"]
      },
      "script": "scripts/audit_engineering.py",
      "readonly": true
    },
    {
      "name": "estimate_change_cost",
      "description": "Always-on cost gate: price cost drivers in the diff (infra, LLM calls, schedules, CI, polling), compare to budget.json, write cost-estimate report.",
      "parameters": {
        "type": "object",
        "properties": {
          "project_root": { "type": "string" },
          "base": { "type": "string", "description": "Git ref to diff against (default origin/main, main)" },
          "diff_file": { "type": "string", "description": "Unified diff to read instead of git" },
          "terraform_plan_json": { "type": "string", "description": "terraform show -json output to validate infra cost" },
          "infracost_json": { "type": "string", "description": "infracost diff --format json output; overrides Terraform guesses" },
          "approved": { "type": "string", "description": "User's reason for going over budget; writes an ADR" },
          "check": { "type": "boolean", "description": "Exit non-zero when over budget" }
        },
        "required": ["project_root"]
      },
      "script": "scripts/estimate_change_cost.py",
      "readonly": false
    },
    {
      "name": "append_decision",
      "description": "Append a typed entry (ADR, trade-off, gotcha, how-it-works) to .heyeddi/docs/engineering/decisions.md. Refuses credentials.",
      "parameters": {
        "type": "object",
        "properties": {
          "project_root": { "type": "string" },
          "title": { "type": "string" },
          "context": { "type": "string" },
          "decision": { "type": "string" },
          "type": { "type": "string", "enum": ["decision", "trade-off", "gotcha", "how-it-works"] },
          "consequences": { "type": "string" }
        },
        "required": ["project_root", "title", "context", "decision"]
      },
      "script": "scripts/append_decision.py",
      "readonly": false
    }
  ]
}
